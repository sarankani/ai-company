# Evalyn Control Panel — environment (EX-207). Copy to .env.local for dev,
# or set these as deploy secrets in production. NEVER commit real values.

# --- required ---
# HMAC key for magic-link + session tokens. High-entropy, from a vault.
#   generate: openssl rand -base64 48
SESSION_SECRET=

# --- production repo access (GitHub API read + decision commits) ---
# Omit both in dev to read/write a local checkout instead (LOCAL_REPO_PATH).
GITHUB_REPO=sarankani/ai-company
GITHUB_TOKEN=                 # fine-grained PAT / App token, THIS repo only, contents:write
GITHUB_BRANCH=main           # branch decisions commit to (default: main)

# --- public URL (used to build magic links) ---
PANEL_BASE_URL=https://panel.evalyn.in

# --- email delivery (magic links) ---
# With SMTP_HOST set, links are emailed and NEVER logged (EX-206 H2).
SMTP_HOST=
SMTP_PORT=587                # 587 = STARTTLS, 465 = implicit TLS
SMTP_SECURE=0                # 1 for port 465, 0 otherwise
SMTP_USER=
SMTP_PASS=
NOTIFY_FROM=Evalyn Control Panel <no-reply@evalyn.in>

# --- dev-only ---
# LOCAL_REPO_PATH=..         # read/write a local company-repo checkout
# AUTH_DEV_LOG=1             # print magic links to the server console (dev only)

# --- CRM (ADR-0008) ---
# Supabase Postgres pooled URL in production; any Postgres in Docker;
# unset = zero-setup local PGlite at panel/.crm-data (auto-migrated).
# DATABASE_URL=postgres://user:pass@host:6543/postgres
# Bearer token AI employees present to /api/crm (with X-Agent-Id header).
# CRM_AGENT_TOKEN=
# Optional: live notification push (Supabase Realtime on crm_notifications).
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
